{
  "name": "pi-paas",
  "version": "1.2.0",
  "description": "The tiniest self-hosted PaaS for your Raspberry Pi - deploy and manage web apps from the browser",
  "main": "backend/server.js",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HexLions/pi-paas.git"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "PIPAAS_DATA_DIR=./.dev-data PIPAAS_PASSWORD=devpassword node backend/server.js",
    "set-password": "node backend/cli.js set-password",
    "test": "node --test test/*.test.js",
    "lint": "for f in backend/*.js frontend/*.js test/*.js; do node --check \"$f\" || exit 1; done && shellcheck install.sh"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "codemirror": "^5.65.18",
    "express": "^5.1.0",
    "fs-extra": "^11.4.1",
    "multer": "^2.0.2",
    "multicast-dns": "^7.2.5",
    "node-cron": "^4.6.0",
    "qrcode-generator": "^2.0.4",
    "yauzl": "^3.2.0"
  },
  "bin": {
    "pipaas": "cli/pipaas.js"
  }
}
